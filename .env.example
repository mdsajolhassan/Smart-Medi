# Smart Medi - Environment Configuration Example
# Copy to .env (required: pubspec bundles .env as an asset, the build fails without it).

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Alternative vision AI for handwritten prescription scanning ---
# Any OpenAI-compatible /chat/completions endpoint. Default: OpenRouter (https://openrouter.ai/keys)
ALT_AI_API_KEY=
# ALT_AI_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated vision models, tried in order:
# ALT_AI_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,openrouter/free

# Which provider to try first when both are configured: alternative | gemini
AI_PRIMARY_PROVIDER=alternative
